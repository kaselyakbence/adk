# Box-local file, created by hand over SSH - never commit the real one
# (gitignored). Must use the same Postgres credentials as ./.env, with
# "postgres" as the host (the compose service name, not localhost).

DATABASE_URL="postgresql://adk:change-me@postgres:5432/adk_washing?schema=public"
PORT=3000
MODE=production

# Same VAPID keypair as backend/.env locally - generated once via
# web-push's generateVAPIDKeys(), shared between environments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ssv-adk20.example
