# Box-local file, created by hand over SSH - never commit the real one
# (already gitignored). Docker Compose auto-loads this both to populate
# ${VAR} references in docker-compose.yml and, via postgres's env_file, to
# initialize the Postgres container itself.

POSTGRES_USER=adk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adk_washing

# Same values as frontend/.env locally - baked into the frontend image at
# build time, so a change here requires a rebuild, not just a redeploy.
NEXT_PUBLIC_API_URL=https://<ip-with-dashes>.sslip.io/api
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Hostname Caddy requests its TLS cert for - the sslip.io host that encodes
# the box's static IP (e.g. 1-2-3-4.sslip.io), or the real domain later.
SITE_ADDRESS=<ip-with-dashes>.sslip.io
