
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id Int @id @default(autoincrement())
  number Int
  start_date DateTime?
  end_date DateTime
  type String
  owner String
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id])
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
model Event {
  id            Int                 @id @default(autoincrement())
  title         String
  description   String?
  location      String?
  startDate     DateTime
  endDate       DateTime?
  // Null = the frontend shows its placeholder poster.
  imageUrl      String?
  createdAt     DateTime            @default(now())
  subscriptions EventSubscription[]
}

// Kept separate from PushSubscription on purpose - the device update route
// wipes all of a device's subscriptions on every new booking, which has
// nothing to do with event reminders.
model EventSubscription {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([eventId, endpoint])
}
